# 环境 / 密钥
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# 前端
node_modules/
dist/
dist.bak/
.vite/

# 大文件数据产物（由 scripts/ 重新生成，不入库）
data/processed/*.csv
data/processed/*.db
data/raw/*.xlsx
*.tmp

# 日志与导出
*.log

# 临时工作目录
.workbuddy/ppt/
.workbuddy/tmp/

# 无关参考资料压缩包（非本项目交付物，仅本地留存，不入库）
docs/*.zip

# git filter-branch 历史重写产生的临时目录
.git-rewrite/

# HTTPS 自签证书（含私钥，严禁入库）
certs/
