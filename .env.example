# 环境配置示例（复制为 .env 后填写；.env 已被 .gitignore 忽略，不入库、不打包交付）
# 注意：变量名与代码**严格对应**（app/backend/config.py、scripts/agent/llm_client.py、orchestrator.py）

# ===== 大模型通道（可选；不配置则自动走规则通道，功能不受影响）=====
# OpenAI 兼容接口，国内直连（本项目实测 SiliconFlow）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Pro/deepseek-ai/DeepSeek-R1
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
# 通道开关：llm=启用大模型意图解析；rule 或留空=仅规则通道（零依赖、亚秒级）
LLM_MODE=rule

# ===== 后端鉴权（config.py：SECRET_KEY）=====
# 生产环境必须修改为高强度随机值，切勿使用默认值
APP_SECRET_KEY=change-me-in-production
# 说明：令牌有效期当前固定为 24 小时（config.py 的 ACCESS_TOKEN_EXPIRE），不通过环境变量配置

# ===== 数据路径（config.py：APP_DB_PATH）=====
# 应用状态库（users / reports），与事实表物理隔离
APP_DB_PATH=data/processed/app.db
# 唯一事实表固定为 data/processed/report_agent.db（代码常量，只读，不通过环境变量覆盖）

# ===== 种子账号（config.py：SEED_USERNAME / SEED_PASSWORD）=====
# 首次启动自动创建；生产环境请删除或改密
SEED_USERNAME=demo
SEED_PASSWORD=demo1234

# ===== 已废弃字段（历史遗留，代码不再读取，仅作说明，勿填）=====
# JWT_SECRET / JWT_EXPIRE_MIN  -> 实际读取 APP_SECRET_KEY，有效期固定 24h
# DB_PATH / SALES_CSV          -> 事实表与 CSV 路径为代码常量
# APP_HOST / APP_PORT          -> 启动参数由命令行传入（uvicorn --host/--port）
# REPORT_CURRENCY / DATA_END_DATE -> 币种 GBP 与数据截止 2011-12-09 由口径文档固定
